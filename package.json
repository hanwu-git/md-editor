{
  "name": "md-editor-tauri",
  "productName": "MD编辑器",
  "version": "6.0.3",
  "description": "本地 Markdown 编辑器：分屏实时预览、Mermaid 流程图、代码高亮、多编码支持、明暗主题（Tauri 重构版）",
  "author": "hanwu",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build && node -e \"const fs=require('fs'),p=require('./package.json'),v=p.version;const s='src-tauri/target/release/md-editor.exe',d='src-tauri/target/release/MD编辑器_'+v+'.exe';fs.copyFileSync(s,d);console.log('Green build:',d)\"",
    "build:nsis": "tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  }
}
