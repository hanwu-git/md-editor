{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD编辑器",
  "version": "6.0.0",
  "identifier": "com.hanwu.mdeditor",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MD编辑器 v6.0.0",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "本地 Markdown 编辑器",
    "longDescription": "分屏实时预览、Mermaid 流程图、代码高亮、多编码支持、明暗主题的本地 Markdown 编辑器",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "txt"],
        "name": "Markdown Document",
        "description": "Markdown / 文本文件",
        "role": "Editor"
      }
    ]
  }
}